# BotFather bergan maxfiy token. GitHub'ga tokenni hech qachon yubormang.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Admin Telegram chat ID. Botda /myid yuborib bilib oling.
ADMIN_CHAT_ID=123456789

# Telegram webhook uchun maxfiy tasdiqlash satri (A-Z, a-z, 0-9, _ va -).
WEBHOOK_SECRET=replace_with_long_random_secret

# Render PUBLIC URL avtomatik beradi. Custom domen ishlatsangiz, WEBAPP_URL'ni o'rnatishingiz mumkin.
# WEBAPP_URL=https://your-service.onrender.com
# PUBLIC_BASE_URL=https://your-service.onrender.com

# Render Free filesystem vaqtinchalik. Faqat lokal/test uchun bu fayl ishlatiladi.
# DATABASE_PATH=./shop.db
